    "lint:fix": "biome check --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@vitest/coverage-v8": "3.2.7",
    "husky": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
