{
  "name": "@usehaia/trace-cli",
  "version": "0.0.9",
  "description": "Haia Trace command-line interface and renderers.",
  "keywords": [
    "x402",
    "circle",
    "arc",
    "payments",
    "receipts",
    "audit-trail",
    "agent-payments",
    "cli",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "Haia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Haia-Finance/haia-trace.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/Haia-Finance/haia-trace/issues",
  "homepage": "https://developers.haia.finance/cli/overview",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "haia-trace": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@usehaia/trace-core": "workspace:*",
    "commander": "^14.0.1",
    "log-symbols": "^7.0.1",
    "nanospinner": "^1.2.2",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@usehaia/trace-circle": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
