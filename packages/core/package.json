{
  "name": "@usehaia/trace-core",
  "version": "0.0.8",
  "description": "Haia Trace core: contracts and the deterministic receipt assembler.",
  "keywords": [
    "x402",
    "circle",
    "arc",
    "payments",
    "receipts",
    "audit-trail",
    "provenance",
    "agent-payments",
    "deterministic"
  ],
  "license": "MIT",
  "author": "Haia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Haia-Finance/haia-trace.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/Haia-Finance/haia-trace/issues",
  "homepage": "https://developers.haia.finance/sdk/core",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./file": {
      "types": "./dist/sink/file.d.ts",
      "default": "./dist/sink/file.js"
    },
    "./cp": {
      "types": "./dist/sink/cp.d.ts",
      "default": "./dist/sink/cp.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
